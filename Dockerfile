# ============================================================================
# DOCKERFILE: Containerized Production Environment
# إدارة وتطوير: أبو العز العمري
# ============================================================================

FROM node:20-alpine

# إنشاء مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملفات الاعتمادات البرمجية أولاً لتحسين التخزين المؤقت
COPY package*.json ./

# تثبيت الحزم الإنتاجية فقط
RUN npm ci --only=production

# نسخ باقي ملفات المشروع إلى الحاوية
COPY . .

# إنشاء مجلد السجلات
RUN mkdir -p logs

# فتح المنفذ الأساسي للخادم
EXPOSE 3000

# أمر تشغيل السيرفر
CMD ["node", "server.js"]
